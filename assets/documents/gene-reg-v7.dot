digraph gene_regulation {
    graph [
        rankdir=TB
        fontname="Helvetica Neue"
        fontsize=14
        bgcolor="#111827"
        pad=0.6
        splines=polyline
        overlap=false
        nodesep=0.45
        ranksep=0.85
        label="Gene Regulation Landscape\nFrom DNA to proteins — reductionist architecture (v7)\n37 mechanisms · 7 layers · 2 meta-principles"
        labelloc=t
        labeljust=c
        fontcolor="#e5e7eb"
    ]

    node [
        fontname="Helvetica Neue"
        fontsize=10
        style="filled,rounded"
        penwidth=1.6
        shape=box
        margin="0.18,0.10"
    ]

    edge [
        fontname="Helvetica Neue"
        fontsize=8
        penwidth=1.1
        arrowsize=0.65
    ]

    // ============================================================
    // LAYER 0 — 3D GENOME
    // ============================================================
    subgraph cluster_3d {
        label="LAYER 0 — 3D Genome"
        fontcolor="#93c5fd"
        fontsize=12
        style="rounded,dashed"
        color="#93c5fd"
        bgcolor="#0c1e35"
        margin=14

        ZONES [label=<
                <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                    <TR><TD><B>ZONES</B></TD></TR>
                    <TR><TD>A/B compartments</TD></TR>
                    <TR><TD>(Hi-C  A=active / B=inactive)</TD></TR>
                </TABLE>
            > fillcolor="#1e3a5f" fontcolor="#bfdbfe" color="#60a5fa"]
        FENCES [label=<
                <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                    <TR><TD><B>FENCES</B></TD></TR>
                    <TR><TD>TADs (CTCF + Cohesin)</TD></TR>
                    <TR><TD>loop extrusion → insulation</TD></TR>
                </TABLE>
            > fillcolor="#1e3a5f" fontcolor="#bfdbfe" color="#60a5fa"]
        BRIDGES [label=<
                <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                    <TR><TD><B>BRIDGES</B></TD></TR>
                    <TR><TD>Enhancer→Promoter loops</TD></TR>
                    <TR><TD>(Mediator + Cohesin + YY1)</TD></TR>
                </TABLE>
            > fillcolor="#1e3a5f" fontcolor="#bfdbfe" color="#60a5fa"]
        HUBS [label=<
                <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                    <TR><TD><B>HUBS</B></TD></TR>
                    <TR><TD>Super-enhancers / Pol II condensates</TD></TR>
                    <TR><TD>(LLPS + BRD4 + master TFs)</TD></TR>
                </TABLE>
            > fillcolor="#162d4a" fontcolor="#bfdbfe" color="#22d3ee" style="filled,rounded,dotted,bold" penwidth=2.8]
    }

    // ============================================================
    // LAYER 1 — EPIGENETICS
    // ============================================================
    subgraph cluster_epi {
        label="LAYER 1 — Epigenetics"
        fontcolor="#86efac"
        fontsize=12
        style="rounded,dashed"
        color="#86efac"
        bgcolor="#0a2215"
        margin=14

        SILENCER [label=<
                <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                    <TR><TD><B>SILENCER</B></TD></TR>
                    <TR><TD>DNA methylation</TD></TR>
                    <TR><TD>(DNMT1/3A/3B ↔ TET  5mC→5hmC)</TD></TR>
                </TABLE>
            > fillcolor="#14532d" fontcolor="#bbf7d0" color="#4ade80"]
        OPENER   [label=<
                <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                    <TR><TD><B>OPENER</B></TD></TR>
                    <TR><TD>Histone acetylation</TD></TR>
                    <TR><TD>(HATs: p300/CBP  HDACs)</TD></TR>
                    <TR><TD>H3K27ac, H3K9ac</TD></TR>
                </TABLE>
            > fillcolor="#14532d" fontcolor="#bbf7d0" color="#4ade80"]
        WRITER_A [label=<
                <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                    <TR><TD><B>WRITER-A</B></TD></TR>
                    <TR><TD>Activating histone methylation</TD></TR>
                    <TR><TD>H3K4me3 (MLL)  H3K36me3 (SETD2)</TD></TR>
                </TABLE>
            > fillcolor="#14532d" fontcolor="#bbf7d0" color="#4ade80"]
        WRITER_R [label=<
                <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                    <TR><TD><B>WRITER-R</B></TD></TR>
                    <TR><TD>Repressive histone methylation</TD></TR>
                    <TR><TD>H3K27me3 (PRC2/EZH2)</TD></TR>
                    <TR><TD>H3K9me3 (SUV39H)  bivalent domains</TD></TR>
                </TABLE>
            > fillcolor="#14532d" fontcolor="#bbf7d0" color="#4ade80"]
        SHUFFLER [label=<
                <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                    <TR><TD><B>SHUFFLER</B></TD></TR>
                    <TR><TD>ATP-dependent chromatin remodeling</TD></TR>
                    <TR><TD>(SWI/SNF, ISWI, CHD, INO80)</TD></TR>
                </TABLE>
            > fillcolor="#14532d" fontcolor="#bbf7d0" color="#4ade80"]
        GUIDES   [label=<
                <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                    <TR><TD><B>GUIDES</B></TD></TR>
                    <TR><TD>Epigenetic ncRNAs</TD></TR>
                    <TR><TD>(piRNA → DNMT3  lncRNA→PRC2</TD></TR>
                    <TR><TD>XIST, HOTAIR, KCNQ1OT1)</TD></TR>
                </TABLE>
            > fillcolor="#0f3d23" fontcolor="#bbf7d0" color="#4ade80"]
    }

    // ============================================================
    // LAYER 2 — TRANSCRIPTION
    // ============================================================
    subgraph cluster_tx {
        label="LAYER 2 — Transcription"
        fontcolor="#fde68a"
        fontsize=12
        style="rounded,dashed"
        color="#fde68a"
        bgcolor="#2a2000"
        margin=14

        KEYS  [label=<
                <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                    <TR><TD><B>KEYS</B></TD></TR>
                    <TR><TD>Transcription factors (TFs)</TD></TR>
                    <TR><TD>(Pioneer: FOXA1, OCT4, GATA3</TD></TR>
                    <TR><TD>~1600 human TFs)</TD></TR>
                </TABLE>
            > fillcolor="#78350f" fontcolor="#fef3c7" color="#f59e0b"]
        SCRIBE [label=<
                <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                    <TR><TD><B>SCRIBE</B></TD></TR>
                    <TR><TD>Pol II + Pausing</TD></TR>
                    <TR><TD>(NELF+DSIF → P-TEFb / <I>CDK9</I>)</TD></TR>
                    <TR><TD>CTD phospho-code: Ser5/Ser2/Ser7</TD></TR>
                </TABLE>
            > fillcolor="#78350f" fontcolor="#fef3c7" color="#f59e0b" style="filled,rounded,bold" penwidth=2.2]
    }

    // ============================================================
    // LAYER 3 — CO-TRANSCRIPTIONAL
    // ============================================================
    subgraph cluster_cotx {
        label="LAYER 3 — Co-transcriptional"
        fontcolor="#fdba74"
        fontsize=12
        style="rounded,dashed"
        color="#fdba74"
        bgcolor="#2d1200"
        margin=14

        SHIELD  [label=<
                <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                    <TR><TD><B>SHIELD</B></TD></TR>
                    <TR><TD>5' Capping (m7G)</TD></TR>
                    <TR><TD>(Ser5-P CTD → CBC → <I>eIF4E</I>)</TD></TR>
                </TABLE>
            > fillcolor="#7c2d12" fontcolor="#fed7aa" color="#fb923c"]
        SPLICER [label=<
                <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                    <TR><TD><B>SPLICER</B></TD></TR>
                    <TR><TD>Alternative splicing</TD></TR>
                    <TR><TD>(SR proteins, hnRNPs, spliceosome)</TD></TR>
                    <TR><TD>kinetic coupling with Pol II</TD></TR>
                </TABLE>
            > fillcolor="#7c2d12" fontcolor="#fed7aa" color="#fb923c" style="filled,rounded,bold" penwidth=2.2]
        TRIMMER [label=<
                <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                    <TR><TD><B>TRIMMER</B></TD></TR>
                    <TR><TD>Alternative polyadenylation (APA)</TD></TR>
                    <TR><TD>CPSF/CstF  AAUAAA</TD></TR>
                    <TR><TD>→ 3'UTR length</TD></TR>
                </TABLE>
            > fillcolor="#7c2d12" fontcolor="#fed7aa" color="#fb923c"]
        RECODER [label=<
                <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                    <TR><TD><B>RECODER</B></TD></TR>
                    <TR><TD>A→I Editing (ADAR1/ADAR2)</TD></TR>
                    <TR><TD>ADARs → inosine</TD></TR>
                    <TR><TD>→ recoding + splice + NMD</TD></TR>
                </TABLE>
            > fillcolor="#6b2500" fontcolor="#fed7aa" color="#fb923c"]
    }

    // ============================================================
    // LAYER 4 — POST-TRANSCRIPTIONAL
    // ============================================================
    subgraph cluster_ptx {
        label="LAYER 4 — Post-transcriptional"
        fontcolor="#c4b5fd"
        fontsize=12
        style="rounded,dashed"
        color="#c4b5fd"
        bgcolor="#1a0830"
        margin=14

        STAMP   [label=<
                <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                    <TR><TD><B>STAMP</B></TD></TR>
                    <TR><TD>m6A epitranscriptome</TD></TR>
                    <TR><TD>(<I>METTL3/14</I> → <I>FTO/ALKBH5</I></TD></TR>
                    <TR><TD><I>YTHDF1/2/3</I>, <I>YTHDC1</I>)</TD></TR>
                </TABLE>
            > fillcolor="#4c1d95" fontcolor="#ddd6fe" color="#a78bfa" style="filled,rounded,bold" penwidth=2.2]
        READERS [label=<
                <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                    <TR><TD><B>READERS</B></TD></TR>
                    <TR><TD>Regulatory RBPs (~1500)</TD></TR>
                    <TR><TD>(<I>HuR</I>, <I>TTP</I>, <I>FMRP</I>, <I>Staufen</I></TD></TR>
                    <TR><TD>SR proteins, hnRNPs)</TD></TR>
                </TABLE>
            > fillcolor="#4c1d95" fontcolor="#ddd6fe" color="#a78bfa" style="filled,rounded,bold" penwidth=2.2]
        DARTS   [label=<
                <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                    <TR><TD><B>DARTS</B></TD></TR>
                    <TR><TD>miRNA-RISC</TD></TR>
                    <TR><TD>(<I>Drosha</I>→<I>Dicer</I>→<I>AGO2</I>)</TD></TR>
                    <TR><TD>~2500 miRNA · 7 nt seed</TD></TR>
                </TABLE>
            > fillcolor="#4c1d95" fontcolor="#ddd6fe" color="#a78bfa"]
        SPONGE  [label=<
                <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                    <TR><TD><B>SPONGE</B></TD></TR>
                    <TR><TD>Cytoplasmic lncRNAs</TD></TR>
                    <TR><TD>(ceRNA: <I>CDR1as</I>, <I>HULC</I></TD></TR>
                    <TR><TD><I>lincRNA-p21</I>, <I>GAS5</I>)</TD></TR>
                </TABLE>
            > fillcolor="#3b1570" fontcolor="#ddd6fe" color="#a78bfa"]
        CENSOR  [label=<
                <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                    <TR><TD><B>CENSOR</B></TD></TR>
                    <TR><TD>NMD</TD></TR>
                    <TR><TD>(<I>UPF1</I> + EJC + <I>SMG1</I></TD></TR>
                    <TR><TD>PTC &gt;50 nt upstream of EJC)</TD></TR>
                </TABLE>
            > fillcolor="#4c1d95" fontcolor="#ddd6fe" color="#f472b6" style="filled,rounded,dashed" penwidth=2.4]
        TIMER   [label=<
                <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                    <TR><TD><B>TIMER</B></TD></TR>
                    <TR><TD>mRNA stability / decay</TD></TR>
                    <TR><TD>(<I>CCR4-NOT</I>→<I>XRN1</I></TD></TR>
                    <TR><TD>deadenylation→decapping)</TD></TR>
                </TABLE>
            > fillcolor="#4c1d95" fontcolor="#ddd6fe" color="#f472b6" style="filled,rounded,dashed" penwidth=2.4]
        CLIPS   [label=<
                <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                    <TR><TD><B>CLIPS</B></TD></TR>
                    <TR><TD>RNA G-quadruplexes (rG4)</TD></TR>
                    <TR><TD>5'UTR → blocks scanning</TD></TR>
                    <TR><TD><I>DHX36</I>, <I>eIF4A</I> helicase</TD></TR>
                </TABLE>
            > fillcolor="#3b1570" fontcolor="#ddd6fe" color="#a78bfa"]
        VAULT   [label=<
                <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                    <TR><TD><B>VAULT</B></TD></TR>
                    <TR><TD>Stress granules / P-bodies</TD></TR>
                    <TR><TD>(<I>G3BP1</I>, <I>TIA-1</I> / <I>DCP1/2</I></TD></TR>
                    <TR><TD>LLPS → storage or decay)</TD></TR>
                </TABLE>
            > fillcolor="#3b1570" fontcolor="#ddd6fe" color="#22d3ee" style="filled,rounded,dotted" penwidth=2.4]
    }

    // ============================================================
    // LAYER 5 — TRANSLATION
    // ============================================================
    subgraph cluster_trad {
        label="LAYER 5 — Translation"
        fontcolor="#fca5a5"
        fontsize=12
        style="rounded,dashed"
        color="#fca5a5"
        bgcolor="#2d0000"
        margin=14

        FORGE  [label=<
                <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                    <TR><TD><B>FORGE</B></TD></TR>
                    <TR><TD>start cap-dependent translation</TD></TR>
                    <TR><TD><I>mTORC1</I> → <I>eIF4F</I> assembly</TD></TR>
                    <TR><TD><I>4E-BP1</I> frees <I>eIF4E</I>; 5'UTR scan</TD></TR>
                </TABLE>
            > fillcolor="#7f1d1d" fontcolor="#fee2e2" color="#f87171"]
        BRAKE  [label=<
                <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                    <TR><TD><B>BRAKE</B></TD></TR>
                    <TR><TD>slow global translation under stress</TD></TR>
                    <TR><TD>ISR: <I>eIF2α</I>-P limits ternary complex</TD></TR>
                    <TR><TD><I>GCN2</I>/<I>PERK</I>/<I>HRI</I>/<I>PKR</I> → <I>ATF4</I></TD></TR>
                </TABLE>
            > fillcolor="#7f1d1d" fontcolor="#fee2e2" color="#f87171" style="filled,rounded,bold" penwidth=2.2]
        DECOY  [label=<
                <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                    <TR><TD><B>DECOY</B></TD></TR>
                    <TR><TD>divert scanning ribosomes with uORFs</TD></TR>
                    <TR><TD>stress bypass can expose main ORF</TD></TR>
                    <TR><TD><I>ATF4</I>, <I>GCN4</I> logic</TD></TR>
                </TABLE>
            > fillcolor="#7f1d1d" fontcolor="#fee2e2" color="#f87171"]
        BYPASS [label=<
                <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                    <TR><TD><B>BYPASS</B></TD></TR>
                    <TR><TD>translate without cap/scanning</TD></TR>
                    <TR><TD>IRES + ITAFs recruit 40S directly</TD></TR>
                    <TR><TD><I>PTB</I>, <I>DAP5</I>, <I>hnRNPQ</I>; <I>HIF1A</I>, <I>VEGFA</I></TD></TR>
                </TABLE>
            > fillcolor="#7f1d1d" fontcolor="#fee2e2" color="#f87171"]
        TEMPO [label=<
                <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                    <TR><TD><B>TEMPO</B></TD></TR>
                    <TR><TD>tune ribosome speed and pausing</TD></TR>
                    <TR><TD>codon bias + tRNA/rRNA modifications</TD></TR>
                    <TR><TD>stalling + co-translational folding</TD></TR>
                </TABLE>
            > fillcolor="#7f1d1d" fontcolor="#fee2e2" color="#f87171"]
        INSPECTOR [label=<
                <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                    <TR><TD><B>INSPECTOR</B></TD></TR>
                    <TR><TD>rescue stalled or broken translation</TD></TR>
                    <TR><TD>RQC / NGD / NSD surveillance</TD></TR>
                    <TR><TD><I>PELO</I>, <I>HBS1L</I>, <I>LTN1</I></TD></TR>
                </TABLE>
            > fillcolor="#7f1d1d" fontcolor="#fee2e2" color="#f87171"]
    }

    // ============================================================
    // LAYER 6 — POST-TRANSLATIONAL
    // ============================================================
    subgraph cluster_ptl {
        label="LAYER 6 — Post-translational"
        fontcolor="#cbd5e1"
        fontsize=12
        style="rounded,dashed"
        color="#cbd5e1"
        bgcolor="#1c1c1c"
        margin=14

        PHOSPHO    [label=<
                <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                    <TR><TD><B>PHOSPHO</B></TD></TR>
                    <TR><TD>switch protein activity or interactions</TD></TR>
                    <TR><TD>kinases ↔ phosphatases; O-GlcNAc crosstalk</TD></TR>
                    <TR><TD><I>PERK</I>/<I>GCN2</I> → <I>eIF2α</I>; <I>CDK9</I> → Pol II</TD></TR>
                </TABLE>
            > fillcolor="#1e293b" fontcolor="#e2e8f0" color="#94a3b8"]
        UBI        [label=<
                <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                    <TR><TD><B>UBI</B></TD></TR>
                    <TR><TD>route proteins by ubiquitin chain type</TD></TR>
                    <TR><TD>K48→proteasome · K63→signal/autophagy</TD></TR>
                    <TR><TD>E1/E2/E3 cascade; degron readers</TD></TR>
                </TABLE>
            > fillcolor="#1e293b" fontcolor="#e2e8f0" color="#94a3b8" style="filled,rounded,bold" penwidth=2.2]
        SUMO_NEDD  [label=<
                <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                    <TR><TD><B>SUMO_NEDD</B></TD></TR>
                    <TR><TD>change localization, repression, or E3 activity</TD></TR>
                    <TR><TD>SUMO marks nuclear complexes</TD></TR>
                    <TR><TD>NEDD8 activates cullin-RING ligases</TD></TR>
                </TABLE>
            > fillcolor="#172030" fontcolor="#e2e8f0" color="#94a3b8"]
        PROTEASOME [
            label=<
                <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                    <TR>
                        <TD><FONT POINT-SIZE="10"><B>PROTEASOME</B></FONT></TD>
                        <TD><FONT POINT-SIZE="8" COLOR="#22d3ee">LLPS</FONT></TD>
                    </TR>
                    <TR><TD COLSPAN="2"><FONT POINT-SIZE="9">destroy short-lived/damaged proteins<BR/>26S UPS reads K48-polyUb<BR/>condensates concentrate cargo</FONT></TD></TR>
                </TABLE>
            >
            fillcolor="#1e293b" fontcolor="#e2e8f0" color="#f472b6" style="filled,rounded,dashed,bold" penwidth=2.8
        ]
        AUTOPHAGY  [label=<
                <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                    <TR><TD><B>AUTOPHAGY</B></TD></TR>
                    <TR><TD>clear large protein/organellar cargo</TD></TR>
                    <TR><TD><I>p62/SQSTM1</I> bridges ubiquitin to <I>LC3</I></TD></TR>
                    <TR><TD>lysosome recycling feeds <I>mTORC1</I></TD></TR>
                </TABLE>
            > fillcolor="#172030" fontcolor="#e2e8f0" color="#f472b6" style="filled,rounded,dashed" penwidth=2.4]
        CHAPERONES [label=<
                <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                    <TR><TD><B>CHAPERONES</B></TD></TR>
                    <TR><TD>fold, refold, or triage proteins</TD></TR>
                    <TR><TD><I>Hsp70/Hsp90/CCT</I> assist folding</TD></TR>
                    <TR><TD>UPR: <I>IRE1</I>, <I>PERK</I>, <I>ATF6</I> sense ER stress</TD></TR>
                </TABLE>
            > fillcolor="#1e293b" fontcolor="#e2e8f0" color="#94a3b8"]
        PAR        [label=<
                <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                    <TR><TD><B>PAR</B></TD></TR>
                    <TR><TD>mark DNA damage with ADP-ribose chains</TD></TR>
                    <TR><TD><I>PARP1</I> builds PAR to recruit repair factors</TD></TR>
                    <TR><TD>PAR nucleates repair condensates</TD></TR>
                </TABLE>
            > fillcolor="#172030" fontcolor="#e2e8f0" color="#22d3ee" style="filled,rounded,dotted" penwidth=2.4]
    }

    // ============================================================
    // TRANSVERSAL META-PRINCIPLES
    // ============================================================
    subgraph cluster_legend {
        label="LEGEND"
        fontcolor="#e5e7eb"
        fontsize=11
        style="rounded"
        color="#64748b"
        bgcolor="#111827"
        margin=10

        LEGEND [
            shape=plain
            margin=0
            label=<
                <TABLE BORDER="1" COLOR="#64748b" BGCOLOR="#111827" CELLBORDER="0" CELLSPACING="4" CELLPADDING="4">
                    <TR><TD ALIGN="CENTER"><FONT COLOR="#e5e7eb"><B>Legend</B></FONT></TD></TR>
                    <TR><TD ALIGN="LEFT"><FONT COLOR="#e5e7eb">solid arrow = primary/direct relation</FONT></TD></TR>
                    <TR><TD ALIGN="LEFT"><FONT COLOR="#e5e7eb">dashed arrow = indirect/context/feedback</FONT></TD></TR>
                    <TR><TD ALIGN="LEFT"><FONT COLOR="#ef4444">⊣ blunt arrow = inhibition/repression</FONT></TD></TR>
                    <TR><TD ALIGN="LEFT"><FONT COLOR="#22d3ee">cyan dotted border = LLPS / condensate mechanism</FONT></TD></TR>
                    <TR><TD ALIGN="LEFT"><FONT COLOR="#f472b6">pink dashed border = decay / clearance mechanism</FONT></TD></TR>
                    <TR><TD ALIGN="LEFT"><FONT COLOR="#93c5fd">blue boxes = layer 0 / 3D genome</FONT></TD></TR>
                    <TR><TD ALIGN="LEFT"><FONT COLOR="#86efac">green boxes = layer 1 / epigenetics</FONT></TD></TR>
                    <TR><TD ALIGN="LEFT"><FONT COLOR="#fde68a">gold boxes = layer 2 / transcription</FONT></TD></TR>
                    <TR><TD ALIGN="LEFT"><FONT COLOR="#fdba74">orange boxes = layer 3 / co-transcriptional</FONT></TD></TR>
                    <TR><TD ALIGN="LEFT"><FONT COLOR="#c4b5fd">purple boxes = layer 4 / post-transcriptional</FONT></TD></TR>
                    <TR><TD ALIGN="LEFT"><FONT COLOR="#fca5a5">red boxes = layer 5 / translation</FONT></TD></TR>
                    <TR><TD ALIGN="LEFT"><FONT COLOR="#cbd5e1">gray boxes = layer 6 / post-translational</FONT></TD></TR>
                    <TR><TD ALIGN="LEFT"><FONT COLOR="#e5e7eb">co-tx=co-transcriptional · A=accessibility · B=mark/readout · C=kinetic coupling</FONT></TD></TR>
                </TABLE>
            >
        ]
    }

    // ============================================================
    // METAPRINCIPLES (visual legend in the graph)
    // ============================================================
    // A = physical accessibility, B = reversible mark, C = kinetic coupling
    // (encoded in edge annotations)

    // ============================================================
    // INTRA-LAYER 0 RELATIONS
    // ============================================================
    ZONES  -> FENCES  [label="constrains" color="#60a5fa" fontcolor="#60a5fa" style=dashed]
    FENCES -> BRIDGES [label="delimits" color="#60a5fa" fontcolor="#60a5fa"]
    BRIDGES -> HUBS   [label="anchors" color="#60a5fa" fontcolor="#60a5fa"]

    // ============================================================
    // INTRA-LAYER 1 RELATIONS
    // ============================================================
    SILENCER -> WRITER_R [label="co-recruit\nco-occupy" color="#4ade80" fontcolor="#4ade80" style=dashed dir=both]
    OPENER   -> SHUFFLER [label="acetyl marks\nrecruit readers/remodelers" color="#4ade80" fontcolor="#4ade80" style=dashed]

    // ============================================================
    // LAYER 1 → LAYER 0 (marks define compartments)
    // ============================================================
    WRITER_R -> ZONES [label="H3K27me3/K9me3\n→ comp. B" color="#4ade80" fontcolor="#4ade80" style=dashed penwidth=1.5]
    SILENCER -> ZONES [label="5mC\n→ comp. B" color="#4ade80" fontcolor="#4ade80" style=dashed]
    OPENER   -> ZONES [label="H3K27ac\n→ comp. A" color="#4ade80" fontcolor="#4ade80" style=dashed]
    SCRIBE   -> ZONES [label="active txn\n→ comp. A" color="#f59e0b" fontcolor="#f59e0b" style=dashed]

    // ============================================================
    // LAYER 0 → LAYER 1 (compartments maintain marks)
    // ============================================================
    ZONES  -> WRITER_R [label="B comp. ↔\nH3K27/9me3" color="#60a5fa" fontcolor="#60a5fa" style=dashed]
    OPENER -> HUBS     [label="H3K27ac\n→ BRD4 hubs" color="#60a5fa" fontcolor="#60a5fa" style=dashed]
    HUBS   -> OPENER   [label="SEs maintain\nenhancer acetylation" color="#60a5fa" fontcolor="#60a5fa" style=dashed]
    GUIDES -> SILENCER [label="piRNA→DNMT3\nde novo 5mC" color="#4ade80" fontcolor="#4ade80"]

    // ============================================================
    // LAYER 1 → LAYER 2
    // ============================================================
    OPENER   -> KEYS   [label="open chromatin\n→ TF access" color="#4ade80" fontcolor="#4ade80"]
    WRITER_R -> KEYS   [label="compact chromatin\n→ TF exclusion" color="#ef4444" fontcolor="#ef4444" arrowhead=tee]
    SHUFFLER -> KEYS   [label="nucleosome\nremodeling" color="#4ade80" fontcolor="#4ade80"]
    WRITER_A -> SCRIBE [label="H3K4me3\n→ Pol II recruit" color="#4ade80" fontcolor="#4ade80"]
    HUBS     -> SCRIBE [label="P-TEFb release\npause→elongation" color="#f59e0b" fontcolor="#f59e0b" penwidth=2]

    // ============================================================
    // LAYER 1 — missing connections (WRITER_A, GUIDES, SPONGE)
    // ============================================================
    KEYS   -> OPENER   [label="TF→p300/CBP\n→ H3K27ac" color="#f59e0b" fontcolor="#f59e0b" penwidth=1.8]
    KEYS   -> SHUFFLER [label="TF→BAF/SWI-SNF\nrecruitment" color="#f59e0b" fontcolor="#f59e0b" penwidth=1.8]
    KEYS   -> WRITER_A [label="TF→MLL\n→ H3K4me3" color="#f59e0b" fontcolor="#f59e0b" style=dashed]
    KEYS   -> GUIDES   [label="TF drives\npiRNA/lncRNA loci" color="#f59e0b" fontcolor="#f59e0b" style=dashed]
    KEYS   -> SPONGE   [label="TF drives\nlncRNA txn" color="#f59e0b" fontcolor="#f59e0b" style=dashed]
    KEYS   -> SCRIBE   [label="TF→Mediator/PIC\n→ Pol II recruitment" color="#f59e0b" fontcolor="#f59e0b" penwidth=2]
    KEYS   -> HUBS     [label="master TF clusters\n→ SE identity" color="#f59e0b" fontcolor="#f59e0b" penwidth=1.8]
    KEYS   -> RECODER  [label="IFN TFs\n→ ADAR1p150" color="#f59e0b" fontcolor="#f59e0b" style=dashed]

    // ============================================================
    // LAYER 2 → LAYER 3
    // ============================================================
    SCRIBE -> SHIELD  [label="Ser5-P CTD\n→ capping co-tx" color="#f59e0b" fontcolor="#f59e0b"]
    SCRIBE -> SPLICER [label="Pol II rate\n→ exon inclusion\n(kinetic coupling C)" color="#f59e0b" fontcolor="#f59e0b" penwidth=2 style=bold]
    SCRIBE -> TRIMMER [label="CTD → CstF\ncleavage/polyA" color="#f59e0b" fontcolor="#f59e0b"]
    SCRIBE -> STAMP   [label="CTD recruits METTL3/14\n(co-tx m6A, B)" color="#f59e0b" fontcolor="#f59e0b" penwidth=2]
    SCRIBE -> WRITER_A [label="SETD2 coupled\nSer2-P → H3K36me3 (C)" color="#f59e0b" fontcolor="#f59e0b" penwidth=2 style=bold]
    WRITER_A -> SPLICER [label="H3K36me3→MRG15\n→PTB→exon incl.(B)" color="#4ade80" fontcolor="#4ade80" penwidth=2 style=bold]

    // ============================================================
    // LAYER 3 → LAYER 4
    // ============================================================
    SPLICER -> CENSOR  [label="PTC from\nalternative exons" color="#fb923c" fontcolor="#fb923c"]
    TRIMMER -> READERS [label="3'UTR length\n→ RBP sites" color="#fb923c" fontcolor="#fb923c"]
    TRIMMER -> DARTS   [label="3'UTR length\n→ miRNA sites" color="#fb923c" fontcolor="#fb923c"]
    RECODER -> SPLICER [label="A→I at 5'SS\n→ splice change" color="#fb923c" fontcolor="#fb923c" dir=both penwidth=2 style=bold]
    RECODER -> CENSOR  [label="Alu exon→PTC\n→ NMD (or prevents)" color="#fb923c" fontcolor="#fb923c"]

    // ============================================================
    // m6A (STAMP) — transversal layer 4 mechanism
    // ============================================================
    STAMP -> SPLICER [label="YTHDC1→SRSF\n(co-tx, B)" color="#a78bfa" fontcolor="#a78bfa" dir=back style=dashed]
    STAMP -> TIMER   [label="YTHDF2→CCR4-NOT\n(decay)" color="#a78bfa" fontcolor="#a78bfa"]
    STAMP -> FORGE   [label="YTHDF1→eIF3\n(initiation ↑)" color="#a78bfa" fontcolor="#a78bfa"]
    STAMP -> BYPASS  [label="5'UTR m6A\n→ cap-independent translation" color="#a78bfa" fontcolor="#a78bfa"]

    // ============================================================
    // RBPs (READERS) — transversal
    // ============================================================
    READERS -> SPLICER [label="SR/hnRNP\n→ splice (A)" color="#a78bfa" fontcolor="#a78bfa" dir=back style=dashed]
    READERS -> TIMER   [label="HuR (stabilize)\nTTP (decay)" color="#a78bfa" fontcolor="#a78bfa"]
    READERS -> FORGE   [label="FMRP represses\ninitiation" color="#a78bfa" fontcolor="#a78bfa" arrowhead=tee]

    // ============================================================
    // Relations intra-couche 4
    // ============================================================
    DARTS  -> TIMER  [label="deadenylation\n+ decay" color="#a78bfa" fontcolor="#a78bfa"]
    SPONGE -> DARTS  [label="ceRNA sponge\n(A)" color="#a78bfa" fontcolor="#a78bfa" arrowhead=tee]
    CENSOR -> TIMER  [label="triggers\ndegradation" color="#a78bfa" fontcolor="#a78bfa"]
    TIMER  -> VAULT  [label="stored or\ndegraded" color="#a78bfa" fontcolor="#a78bfa" dir=both]
    CLIPS  -> FORGE  [label="5'UTR rG4\nblocks scanning" color="#a78bfa" fontcolor="#a78bfa" arrowhead=tee]
    CLIPS  -> BYPASS [label="modulates\nIRES activity" color="#a78bfa" fontcolor="#a78bfa"]
    STAMP  -> CLIPS  [label="m6A destab.\nrG4 structure" color="#a78bfa" fontcolor="#a78bfa" style=dashed]

    // ============================================================
    // LAYER 4 → LAYER 5
    // ============================================================
    DARTS  -> FORGE  [label="blocks\ninitiation" color="#a78bfa" fontcolor="#a78bfa" arrowhead=tee]
    SHIELD -> FORGE  [label="cap→eIF4E\nbinding" color="#fb923c" fontcolor="#fb923c"]

    // ============================================================
    // Relations intra-couche 5
    // ============================================================
    BRAKE -> DECOY  [label="eIF2α-P → TC↓\nuORF bypass → ATF4(C)" color="#ef4444" fontcolor="#ef4444" penwidth=2 style=bold]
    BRAKE -> BYPASS [label="cap-dep blocked\n→ IRES active" color="#ef4444" fontcolor="#ef4444"]
    DECOY -> FORGE  [label="regulate\ninitiation" color="#ef4444" fontcolor="#ef4444" arrowhead=tee]
    FORGE -> INSPECTOR [label="elongation stalls\n→ RQC/NGD" color="#ef4444" fontcolor="#ef4444"]
    TEMPO -> INSPECTOR [label="codon/tRNA tempo\n→ ribosome stalls" color="#ef4444" fontcolor="#ef4444"]
    TEMPO -> CHAPERONES [label="translation speed\n→ co-translational folding" color="#ef4444" fontcolor="#ef4444" style=dashed]
    INSPECTOR -> PROTEASOME [label="RQC ubiquitinates\nnascent chains" color="#94a3b8" fontcolor="#94a3b8"]

    // ============================================================
    // LAYER 5 → LAYER 6
    // ============================================================
    FORGE  -> CHAPERONES [label="co-translational\nfolding" color="#f87171" fontcolor="#f87171"]
    FORGE  -> PHOSPHO    [label="mTOR→AKT\n→ kinases" color="#f87171" fontcolor="#f87171" style=dashed]

    // ============================================================
    // Relations intra-couche 6
    // ============================================================
    PHOSPHO    -> UBI        [label="phospho-degron\n→ E3 ligase" color="#94a3b8" fontcolor="#94a3b8"]
    UBI        -> PROTEASOME [label="K48 chains\n→ 26S (A)" color="#94a3b8" fontcolor="#94a3b8" penwidth=2]
    UBI        -> AUTOPHAGY  [label="p62 reads\nK63 chains" color="#94a3b8" fontcolor="#94a3b8"]
    SUMO_NEDD  -> UBI        [label="STUbLs:\nSUMO→Ub" color="#94a3b8" fontcolor="#94a3b8" style=dashed]
    PHOSPHO    -> SUMO_NEDD  [label="phospho-dep.\nSUMO recruit" color="#94a3b8" fontcolor="#94a3b8" style=dashed]
    PAR        -> PROTEASOME [label="PARylation →\nproteolytic condensates" color="#94a3b8" fontcolor="#94a3b8"]

    // ============================================================
    // FEEDBACKS LAYER 6 → upstream layers
    // ============================================================
    CHAPERONES -> BRAKE [label="UPR: PERK\n= eIF2α kinase" color="#94a3b8" fontcolor="#94a3b8" style=dashed penwidth=2]
    PHOSPHO    -> SCRIBE [label="P-TEFb/CDK9\nSer2-CTD" color="#94a3b8" fontcolor="#94a3b8"]
    PHOSPHO    -> BRAKE  [label="eIF2α kinases\n(PERK, GCN2)" color="#94a3b8" fontcolor="#94a3b8"]
    PROTEASOME -> KEYS   [label="IκBα decay\n→ NF-κB activ." color="#94a3b8" fontcolor="#94a3b8" style=dashed]

    // ============================================================
    // RANKING
    // ============================================================
    { rank=same; ZONES; FENCES; BRIDGES; HUBS }
    { rank=same; SILENCER; OPENER; WRITER_A; WRITER_R; SHUFFLER; GUIDES }
    { rank=same; KEYS; SCRIBE }
    { rank=same; SHIELD; SPLICER; TRIMMER; RECODER }
    { rank=same; STAMP; READERS; DARTS; SPONGE; CENSOR; TIMER; CLIPS; VAULT }
    { rank=same; FORGE; BRAKE; DECOY; BYPASS; TEMPO; INSPECTOR }
    { rank=same; PHOSPHO; UBI; SUMO_NEDD; PROTEASOME; AUTOPHAGY; CHAPERONES; PAR }
    { rank=min; LEGEND }
}
